{
  "name": "trade-republic-sdk",
  "version": "0.3.0",
  "description": "Unofficial TypeScript SDK for the Trade Republic private API.",
  "homepage": "https://github.com/Nils-Fischer/trade-republic-sdk#readme",
  "bugs": {
    "url": "https://github.com/Nils-Fischer/trade-republic-sdk/issues"
  },
  "license": "MIT",
  "author": "Nils Fischer <nils-fischer7@web.de>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nils-Fischer/trade-republic-sdk.git"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./react": "./dist/react.js",
    "./testing": "./dist/testing.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "test:live": "bun tests/live/account.ts",
    "test:live:tr-account": "bun tests/live/tr-account.ts",
    "check": "vp check",
    "release": "bumpp",
    "prepublishOnly": "vp run build",
    "prepare": "vp config"
  },
  "dependencies": {
    "arktype": "^2.2.3"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.78.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "bumpp": "^11.1.0",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.8",
    "vite-plus": "^0.2.4"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.8"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.13",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.4.0"
  }
}
